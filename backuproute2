        const safeActiveScore = !isNaN(numScore) ? numScore.toFixed(1) : "0.0";

        windInfoElem.innerHTML = `  
            <strong>${dynamiqueRecommendation}</strong>  
            <br>  
            📍 Vue : Route ${currentView}  
            <br>  
            📏 Distance : ${distanceKm} km  
            <br>  
            ${gainText}  
            <br>  
            📊 Indice effort vent : ${safeActiveScore}  
        `;
    }
}

    const windInfoElem = document.getElementById("windInfo");
    if (windInfoElem) {
        const safeActiveScore = typeof activeScore === 'number' ? activeScore.toFixed(1) : parseFloat(activeScore || 0).toFixed(1);
        windInfoElem.innerHTML = `  
